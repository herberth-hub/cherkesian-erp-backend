generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // conexão com pooler (app)
  directUrl = env("DIRECT_URL")   // conexão direta (migrations)
}

// ===== Enums =====
enum Acesso {
  total
  comercial
  producao
  chao
  expedicao
  financeiro
  contabilidade
  consultoria
}

enum PedidoEtapa {
  orcamento
  aprovado
  piloto
  material
  compra
  producao
  estoque
  expedicao
  parcial
  concluido
}

enum PilotoStatus {
  em_desenvolvimento
  enviada_ao_cliente
  aprovada
  aprovada_c_ajustes
  reprovada
}

enum OPStatus {
  aguardando_material
  a_iniciar
  em_corte
  em_producao
  em_faccao
  concluido
}

enum Prioridade {
  alta
  media
  baixa
}

enum TituloStatus {
  a_vencer
  vencendo
  vencida
  pago
}

enum OCStatus {
  aguardando
  recebida
  cancelada
}

// ===== Núcleo =====
model Empresa {
  id        Int      @id @default(autoincrement())
  nome      String
  regime    String   @default("Lucro Presumido")
  criadoEm  DateTime @default(now())
  usuarios  Usuario[]
  clientes  Cliente[]
  filiais   Filial[]

  // ===== Dados fiscais (emitente da NF-e) =====
  cnpj              String?
  inscricaoEstadual String?
  crt               Int?    @default(3) // 1=Simples, 2=Simples excesso, 3=Regime Normal
  nomeFantasia      String?
  logradouro        String?
  numeroEndereco    String?
  complemento       String?
  bairro            String?
  municipio         String?
  codMunicipio      String? // código IBGE (7 dígitos)
  uf                String?
  cep               String?
  telefone          String?
  // Numeração da NF-e (continuar de onde o sistema anterior parou)
  nfeSerie          String  @default("1")
  nfeProximoNumero  Int     @default(1)
  // Logo (data URI base64) — sai no cabeçalho dos documentos em PDF.
  logo              String? @db.Text
  // Peso da embalagem unitária (saquinho/individual por peça), em kg — entra no peso bruto.
  pesoEmbalagemUnit Decimal? @db.Decimal(10,3)
}

// Filial / estabelecimento do grupo (matriz + filiais). Cada CNPJ é um emitente
// de NF-e independente, com sua PRÓPRIA numeração fiscal (série + próximo número)
// e, opcionalmente, seu próprio token Focus NFe. A operação (clientes, produtos,
// estoque, financeiro) é compartilhada; o pedido/OP/NF escolhem a filial emissora.
model Filial {
  id                Int      @id @default(autoincrement())
  empresaId         Int
  empresa           Empresa  @relation(fields: [empresaId], references: [id])
  nome              String   // "Matriz", "Filial São Paulo"...
  matriz            Boolean  @default(false)
  ativa             Boolean  @default(true)
  // ===== Dados fiscais (emitente da NF-e) =====
  cnpj              String?
  inscricaoEstadual String?
  crt               Int?    @default(3)
  // ===== Parâmetros tributários (por empresa/CNPJ) =====
  regimeTributario  String   @default("lucro_presumido") // lucro_real | lucro_presumido | simples
  icmsInterno       Decimal? @db.Decimal(5,2)  // alíquota ICMS interna (ex.: 18.00)
  icmsCstPadrao     String?  @default("00")     // CST ICMS padrão (regime normal)
  pisAliquota       Decimal? @db.Decimal(6,4)   // ex.: 0.6500 (presumido) / 1.6500 (real)
  cofinsAliquota    Decimal? @db.Decimal(6,4)   // ex.: 3.0000 (presumido) / 7.6000 (real)
  pisCofinsCst      String?  @default("01")      // CST PIS/COFINS (49 no Simples)
  csosn             String?                       // CSOSN padrão (Simples Nacional, ex.: 102)
  // ===== Reforma Tributária (IBS/CBS) — período de transição =====
  reformaAtiva      Boolean  @default(true)        // inclui grupo IBS/CBS na NF-e
  cbsAliquota       Decimal? @db.Decimal(6,4)      // ex.: 0.9000 (2026)
  ibsUfAliquota     Decimal? @db.Decimal(6,4)      // ex.: 0.1000 (IBS estadual/UF, 2026)
  ibsMunAliquota    Decimal? @db.Decimal(6,4)      // ex.: 0.0000 (IBS municipal, 2026)
  ibsCbsCst         String?  @default("000")        // CST do IBS/CBS
  ibsCbsClassTrib   String?  @default("000001")     // cClassTrib (classificação tributária)
  pesoMedioPeca     Decimal? @db.Decimal(8,3)       // kg por peça (estimativa p/ peso bruto/líquido na NF)
  nomeFantasia      String?
  logradouro        String?
  numeroEndereco    String?
  complemento       String?
  bairro            String?
  municipio         String?
  codMunicipio      String?
  uf                String?
  cep               String?
  telefone          String?
  nfeSerie          String  @default("1")
  nfeProximoNumero  Int     @default(1)
  nfeAmbiente       String? // homologacao | producao — sobrepõe o NFE_AMBIENTE global (null = usa o global)
  focusToken        String? // token Focus NFe genérico da filial (fallback)
  focusTokenHomolog String? // token Focus de HOMOLOGAÇÃO da empresa (por CNPJ)
  focusTokenProd    String? // token Focus de PRODUÇÃO da empresa (por CNPJ)
  dadosBancarios    String? @db.Text // banco/agência/conta/PIX/favorecido — sai na proposta/pedido
  criadoEm          DateTime @default(now())
  pedidos           Pedido[]
  ops               OP[]
  notasFiscais      NotaFiscal[]
  notasEntrada      NotaEntrada[]
  contasPagar       ContaPagar[]
  contasReceber     ContaReceber[]
  contasBancarias   ContaBancaria[]
}

/// Conta bancária estruturada da empresa/CNPJ (várias por filial) — usada para
/// registrar de qual conta saiu o pagamento na baixa de contas a pagar.
model ContaBancaria {
  id        Int      @id @default(autoincrement())
  empresaId Int
  filialId  Int
  filial    Filial   @relation(fields: [filialId], references: [id])
  banco     String   // ex.: Santander
  agencia   String?  // ex.: 4338
  conta     String?  // ex.: 130019372
  tipo      String   @default("corrente") // corrente | poupanca | pagamentos
  pixChave  String?
  apelido   String?  // rótulo curto (ex.: "Conta principal HC")
  principal Boolean  @default(false)
  ativa     Boolean  @default(true)
  criadoEm  DateTime @default(now())

  @@index([empresaId])
  @@index([filialId])
}

model Usuario {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  nome          String
  usuario       String   @unique
  senhaHash     String
  cargo         String?
  setor         String?
  acesso        Acesso   @default(comercial)
  horarioInicio String?  // "08:00"
  horarioFim    String?  // "18:00"
  ativo         Boolean  @default(true)
  // Segurança: bloqueio de conta após tentativas de login malsucedidas.
  tentativasFalhas Int      @default(0)
  bloqueado        Boolean  @default(false)
  bloqueadoEm      DateTime?
  criadoEm      DateTime @default(now())
  atualizadoEm  DateTime @updatedAt
}

model Cliente {
  id         Int      @id @default(autoincrement())
  empresaId  Int
  empresa    Empresa  @relation(fields: [empresaId], references: [id])
  nome       String
  fantasia   String?
  grupo      String?  // grupo de clientes (ex.: rede/matriz que agrupa várias unidades)
  cnpjCpf    String?
  contato    String?
  telefone   String?
  email      String?
  cidadeUf   String?
  segmento   String?
  clienteNovo Boolean @default(true)
  obs        String?
  pedidos    Pedido[]
  medidas    Medida[]
  criadoEm   DateTime @default(now())

  // ===== Crédito (consulta na criação de pedido; restrição bloqueia) =====
  creditoLiberado    Boolean  @default(false) // override do admin p/ vender mesmo com restrição
  creditoLiberadoPor String?
  creditoLiberadoEm  DateTime?
  consultasCredito   ConsultaCredito[]

  // ===== Dados fiscais (destinatário da NF-e) =====
  inscricaoEstadual String?
  indicadorIE       Int?    // 1=Contribuinte, 2=Isento, 9=Não contribuinte
  logradouro        String?
  numeroEndereco    String?
  bairro            String?
  municipio         String?
  codMunicipio      String?
  uf                String?
  cep               String?

  unidades          ClienteUnidade[]
}

// Filial / unidade DENTRO de um cliente (ex.: rede INTS → unidade "SACA").
// Organiza a busca e, quando tem CNPJ/endereço próprios, vira o destinatário da NF.
model ClienteUnidade {
  id                Int      @id @default(autoincrement())
  clienteId         Int
  cliente           Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  nome              String   // nome/apelido da unidade (ex.: "SACA")
  cnpjCpf           String?
  inscricaoEstadual String?
  indicadorIE       Int?     // 1=Contribuinte, 2=Isento, 9=Não contribuinte
  logradouro        String?
  numeroEndereco    String?
  bairro            String?
  municipio         String?
  codMunicipio      String?
  uf                String?
  cep               String?
  email             String?
  criadoEm          DateTime @default(now())

  @@index([clienteId])
}

model ConsultaCredito { // Resultado de consulta de crédito/situação do cliente
  id           Int      @id @default(autoincrement())
  empresaId    Int
  clienteId    Int
  cliente      Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  documento    String?  // CNPJ/CPF consultado (só dígitos)
  fonte        String   // brasilapi | simulado | externo
  situacao     String   // regular | restricao | erro
  score        Int?     // 0–1000 quando o provedor retorna
  resumo       String   // texto amigável (ex.: "Situação cadastral: ATIVA")
  detalhe      Json?    // payload bruto do provedor
  consultadoPor String?
  consultadoEm DateTime @default(now())

  @@index([clienteId])
}

/// Configuração da consulta de crédito (Serasa/parceiro) por empresa.
model CreditoConfig {
  id                Int      @id @default(autoincrement())
  empresaId         Int      @unique
  ativo             Boolean  @default(true)   // integração ligada
  provedor          String   @default("auto") // auto | externo | brasilapi | simulado | off
  apiUrl            String?  // endpoint da consulta (use {doc} para o CNPJ/CPF)
  apiToken          String?  @db.Text         // token/Bearer estático (parceiro REST)
  authType          String   @default("bearer") // bearer | oauth2 | none
  oauthTokenUrl     String?  // endpoint do token (OAuth2 client_credentials)
  oauthClientId     String?
  oauthClientSecret String?  @db.Text
  oauthScope        String?
  scoreMin          Int      @default(500)    // score abaixo disso = restrição
  bloqueiaPedido    Boolean  @default(true)   // restrição bloqueia o pedido
  validadeDias      Int      @default(30)     // validade da consulta p/ reaproveitar
  atualizadoEm      DateTime @default(now()) @updatedAt
  atualizadoPor     String?
}

model Fornecedor {
  id           Int    @id @default(autoincrement())
  empresaId    Int
  nome         String
  nomeFantasia String?
  cnpjCpf      String?
  tipo      String?
  contato   String?
  telefone  String?
  cidadeUf  String?
  chavePix  String?   // chave PIX p/ pagamento (CPF/CNPJ, e-mail, celular ou aleatória)
  obs       String?
  // ===== Dados fiscais (p/ NF-e de remessa para industrialização à facção) =====
  faccao            Boolean @default(false) // marca fornecedor que é facção/oficina externa
  inscricaoEstadual String?
  indicadorIE       Int?    // 1=Contribuinte ICMS, 2=Isento, 9=Não contribuinte
  logradouro        String?
  numeroEndereco    String?
  bairro            String?
  municipio         String?
  codMunicipio      String? // código IBGE (7 dígitos)
  uf                String?
  cep               String?
  catalogo     String?  @db.Text // catálogo do fornecedor (data URI base64: PDF/imagem)
  catalogoNome String?  // nome original do arquivo do catálogo
  limiteCredito     Decimal? @db.Decimal(12,2) // crédito que O FORNECEDOR nos concede (compra a prazo)
  condicaoPagamento String?  // condição negociada (ex.: 30/60/90, 28 DDL)
  ordensCompra OrdemCompra[]
  notasEntrada NotaEntrada[]
}

/// Transportadora — dados do transporte que saem no quadro "TRANSPORTADOR" do DANFE.
/// Retalhos de tecido (sobras do corte) — pesados em kg e guardados até a
/// reciclagem no fim do mês. Estoque por PESO (não por peça/etiqueta).
model Retalho {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  filialId    Int?
  descricao   String   // ex.: "Retalho brim leve" — livre
  cor         String?
  composicao  String?  // ex.: "67% poliéster 33% algodão"
  pesoKg      Decimal  @db.Decimal(10,3) // peso pesado na balança
  localizacao String?  // onde está guardado (bag/bombona/prateleira)
  origem      String?  // ex.: OP-0012, "corte", "sobra"
  reciclado   Boolean  @default(false)   // baixado na reciclagem de fim de mês
  recicladoEm DateTime?
  criadoEm    DateTime @default(now())
  criadoPor   String?

  @@index([empresaId, reciclado])
}

model Transportadora {
  id                Int      @id @default(autoincrement())
  empresaId         Int
  nome              String   // razão social / nome
  cnpjCpf           String?
  inscricaoEstadual String?  // IE (ou ISENTO)
  telefone          String?
  logradouro        String?
  numeroEndereco    String?
  bairro            String?
  municipio         String?
  uf                String?
  cep               String?
  placaVeiculo      String?  // placa padrão do veículo (opcional)
  ufVeiculo         String?
  rntc              String?  // Registro Nacional de Transportador de Carga (ANTT)
  ativa             Boolean  @default(true)
  criadoEm          DateTime @default(now())

  @@index([empresaId])
}

model NotaEntrada { // NF de compra recebida do fornecedor (entrada de mercadoria)
  id            Int      @id @default(autoincrement())
  empresaId     Int
  filialId      Int?        // CNPJ destinatário (HC Quality / Cherkesian) que recebeu a mercadoria
  filial        Filial?     @relation(fields: [filialId], references: [id])
  fornecedorId  Int?
  fornecedor    Fornecedor? @relation(fields: [fornecedorId], references: [id])
  numero        String
  serie         String?
  chave         String?  @unique // 44 dígitos (dedupe com a SEFAZ)
  cnpjEmitente  String?
  nomeEmitente  String?
  emitidaEm     DateTime?
  valor         Decimal  @db.Decimal(12,2)
  status        String   @default("registrada") // registrada | manifestada | cancelada
  origem        String   @default("manual")     // manual | sefaz | xml
  lancadaEstoque Boolean @default(false)
  etiquetasGeradas Boolean @default(false) // etiquetas de volume já emitidas para colar nos rolos?
  contaPagarId  Int?     // título gerado no A Pagar (se houver)
  obs           String?
  itens         NotaEntradaItem[]
  ordensRecebidas OrdemCompra[] // OCs baixadas por esta entrada (necessidade × compra)
  criadoEm      DateTime @default(now())
  criadoPor     String?
}

model NotaEntradaItem {
  id            Int         @id @default(autoincrement())
  notaEntradaId Int
  nota          NotaEntrada @relation(fields: [notaEntradaId], references: [id], onDelete: Cascade)
  materialId    Int?        // vínculo opcional à matéria-prima do catálogo (p/ dar entrada no estoque)
  descricao     String
  ncm           String?
  quantidade    Decimal     @db.Decimal(12,3)
  unidade       String      @default("un")
  valorUnit     Decimal     @db.Decimal(12,4)
}

model Produto {
  id        Int      @id @default(autoincrement())
  empresaId Int
  codigo    String   @unique  // PRD-CAT-0000
  categoria String
  descricao String
  cor       String?
  grade     String?
  // Peso e embalagem (cálculo automático de peso líquido/bruto e volumes no pedido/NF)
  pesoUnitario   Decimal? @db.Decimal(10,3) // kg por peça (padrão)
  pesoPorTamanho Json?                        // { "PP":0.32, "M":0.38, ... }
  caixaId        Int?                         // Embalagem tipo caixa
  pecasPorCaixa  Int?                         // encaixe padrão por caixa
  fardoId        Int?                         // Embalagem tipo fardo
  pecasPorFardo  Int?                         // encaixe padrão por fardo
  tipo      String   @default("producao") // producao (industrializado, gera OP) | revenda (comprado p/ revender)
  precoBase Decimal? @db.Decimal(12,2)     // preço de venda padrão (tamanhos normais)
  precoEspecial Decimal? @db.Decimal(12,2) // preço de venda da tabela especial (tamanhos grandes)
  tamsEspeciais String?                    // tamanhos da tabela especial, ex.: "G1,G2,G3,G4,G5"
  custo     Decimal? @db.Decimal(12,2) // custo unitário (revenda: preço de compra; produção: custo direto)
  clienteGrupo String?                     // grupo de cliente dono do produto (ex.: SANTA CASA DE SBC)
  clienteId    Int?                        // cliente específico (opcional)
  setor        String?                     // setor de uso (ex.: HIGIENE/LIMPEZA)
  componentes  Json?                       // conjunto/kit: [{produtoId, quantidade}] — ao gerar OP, explode nestes
  consumo   Consumo[]
  estoque   Estoque[]
  medidas   ProdutoMedida[]

  // ===== Ficha técnica (gerada a partir do cadastro; enviada ao cliente) =====
  referencia     String? // referência do cliente/externa (ex.: 101004966)
  marca          String? // marca / cliente (ex.: CINEMARK)
  linha          String? // linha (ex.: PROFISSIONAL)
  grupo          String? // grupo detalhado (ex.: CALCA)
  modelagem      String? // referência da modelagem no Audaces (ex.: 3174 - N 7005-000AA)
  tecido         String? // tecido principal
  composicao     String? // composição do tecido
  especificacoes String? @db.Text // observações de confecção / costura (texto longo)
  observacoes    String? @db.Text // observações gerais da ficha
  fotoModelo     String? @db.Text // foto do modelo (data URI base64)
  fotoModelagem  String? @db.Text // imagem da modelagem Audaces (data URI base64)
  arquivoModelagem     String? @db.Text // arquivo da modelagem Audaces (.adsx/.zip) em data URI base64
  arquivoModelagemNome String? // nome original do arquivo de modelagem arquivado

  // ===== Dados fiscais (item da NF-e) — validar com a contabilidade =====
  ncm             String? // 8 dígitos
  cfop            String? // 4 dígitos (ex.: 5101 venda de produção no estado)
  origem          Int?    @default(0) // 0=Nacional, 1=Estrangeira import. direta...
  unidadeComercial String? @default("UN")
  cest            String?
  icmsCst         String? // CST (regime normal) ou CSOSN (Simples)
  pisCst          String? @default("01")
  cofinsCst       String? @default("01")
  icmsAliquota    Decimal? @db.Decimal(5,2)
}

model ProdutoMedida { // Tabela de medidas da ficha técnica — 1 linha por medida, valores por tamanho
  id         Int      @id @default(autoincrement())
  produtoId  Int
  produto    Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  ordem      Int      @default(0)
  descricao  String   // ex.: CINTURA, COXA, ENTREPERNAS
  tolerancia String?  // ex.: 1 CM
  valores    Json     @default("{}") // { "PP": "43", "P": "47", ... } por tamanho
}

model Material {
  id        Int      @id @default(autoincrement())
  empresaId Int
  codigo    String   @unique  // MP-CAT-0000
  categoria String
  descricao String
  cor       String?
  unidade   String   @default("un")
  saldo     Decimal  @default(0) @db.Decimal(12,3)
  minimo    Decimal  @default(0) @db.Decimal(12,3)
  custo     Decimal  @default(0) @db.Decimal(12,2)
  localizacao String? // endereço na prateleira/estoque (ex.: "B3") — agiliza a separação no romaneio
  // ===== Ficha do tecido/artigo (da etiqueta do fabricante) =====
  fornecedorId    Int?     // fabricante do tecido (vincula na ficha do fornecedor)
  artigo          String?  // nome do artigo (ex.: ROVASOL PELETIZADO)
  codigoArtigo    String?  // ordem/código do fabricante (ex.: 02.116.001.1)
  composicao      String?  // ex.: 70% ALGODÃO 30% POLIÉSTER
  largura         Decimal? @db.Decimal(6,2)  // metros (ex.: 1,60)
  gramatura       Decimal? @db.Decimal(8,2)  // g/m² (ex.: 127,00)
  gramaturaLinear Decimal? @db.Decimal(8,3)  // g/ml (ex.: 0,215)
  consumo   Consumo[]
}

model Consumo { // BOM — receita por peça
  id         Int      @id @default(autoincrement())
  produtoId  Int
  produto    Produto  @relation(fields: [produtoId], references: [id])
  materialId Int
  material   Material @relation(fields: [materialId], references: [id])
  quantidade Decimal  @db.Decimal(12,4)  // consumo padrão (fallback quando não há por tamanho)
  porTamanho Json?    // consumo por tamanho { "PP":1.73, "P":1.80, ... } na mesma unidade
  unidade    String
}

// ===== Operação =====
model Pedido {
  id             Int          @id @default(autoincrement())
  empresaId      Int
  numero         String       @unique // PV01
  clienteId      Int
  cliente        Cliente      @relation(fields: [clienteId], references: [id])
  clienteUnidadeId Int?       // unidade/filial do cliente destinatária (opcional)
  filialId       Int?         // CNPJ emissor (matriz/filial); null = matriz
  filial         Filial?      @relation(fields: [filialId], references: [id])
  data           DateTime     @default(now())
  prazoEntrega   DateTime?    // prazo combinado de entrega ao cliente (radar anti-atraso)
  valorTotal     Decimal      @db.Decimal(12,2)
  status         String
  formaPagamento String?
  frete          String?      // condição de frete (ex.: "CIF — incluso" / "FOB — por conta do cliente")
  etapa          PedidoEtapa  @default(orcamento)
  clienteNovo    Boolean      @default(false)
  producaoParcial Boolean     @default(false) // produziu só o que o estoque cobria; falta OP complementar
  bonificacao    Boolean      @default(false) // pedido de bonificação: sem conta a receber; NF em remessa de bonificação
  ordemCompraCliente String?  // nº do pedido de compra do cliente (SAP/PO) — sai na NF
  obs            String?    // observação FISCAL: vai nas informações complementares da NF-e
  obsComercial   String?    // observação COMERCIAL: sai na proposta e no pedido (não vai na NF-e)
  itens          PedidoItem[]
  ops            OP[]
  pilotos        Piloto[]
  criadoEm       DateTime     @default(now())
  criadoPor      String?
}

model PedidoItem {
  id                 Int     @id @default(autoincrement())
  pedidoId           Int
  pedido             Pedido  @relation(fields: [pedidoId], references: [id])
  produtoId          Int?
  descricao          String
  cor                String?  // cor escolhida do produto (obrigatória quando o produto tem cores)
  quantidade         Int
  quantidadeExpedida Int     @default(0) // já expedido (faturamento parcial); residual = quantidade - expedida
  valorUnit          Decimal @db.Decimal(12,2)
  grade              Json?   // qtd por tamanho, ex.: {"PP":8,"M":2,"G":2}
  gradeExpedida      Json?   // qtd já expedida por tamanho (parcial por tamanho), ex.: {"P":5}
}

model Piloto {
  id          Int          @id @default(autoincrement())
  codigo      String       @unique // PIL-0007
  pedidoId    Int
  pedido      Pedido       @relation(fields: [pedidoId], references: [id])
  clienteId   Int
  produtoId   Int?
  solicitacao DateTime?
  envio       DateTime?
  prazoRetorno DateTime?
  tentativa   Int          @default(1)
  status      PilotoStatus @default(em_desenvolvimento)
  liberado    Boolean      @default(false)
  obs         String?
}

model OP {
  id             Int      @id @default(autoincrement())
  numero         String   @unique // OP-0031
  pedidoId       Int?
  pedido         Pedido?  @relation(fields: [pedidoId], references: [id])
  filialId       Int?
  filial         Filial?  @relation(fields: [filialId], references: [id])
  produtoId      Int?
  cor            String?  // cor escolhida no pedido (segue p/ corte/costura e kits)
  quantidade     Int
  inicio         DateTime?
  entregaPrev    DateTime?
  status         OPStatus @default(a_iniciar)
  responsavel    String?
  setorAtual     String?
  progresso      Int      @default(0)
  pilotoLiberado Boolean  @default(false)
  prioridade     Prioridade @default(media)
  gradeTamanhos  Json?    // distribuição planejada por tamanho, ex.: {"P":10,"M":20,"G":8}
  romaneioMateriais Json? // materiais do corte (BOM × qtd) c/ conferência: [{materialId,codigo,descricao,quantidade,unidade,conferido,...}]
  gradeCortada   Json?    // quantidade REALMENTE cortada por tamanho (corte parcial se acabar tecido)
  quantidadeCortada Int?  // total cortado (soma da gradeCortada)
  corteParcial   Boolean  @default(false) // true quando cortou menos que o planejado
  corteObs       String?  // observação do corte (ex.: "acabou o tecido, faltou G1/G2")
  lotes          Lote[]
}

model OrdemCompra {
  id           Int        @id @default(autoincrement())
  numero       String     @unique // OC-0012
  fornecedorId Int
  fornecedor   Fornecedor @relation(fields: [fornecedorId], references: [id])
  materialId   Int?
  descricao    String
  quantidade   Decimal    @db.Decimal(12,3)
  unidade      String
  valor        Decimal    @db.Decimal(12,2)
  status       OCStatus   @default(aguardando)
  previsao     DateTime?
  motivo       String?
  // Recebimento vinculado à NF de entrada (necessidade × compra) — a entrada da NF
  // dá baixa automática na OC; o estoque entra só uma vez (na NF), sem duplicar.
  notaEntradaId Int?
  notaEntrada   NotaEntrada? @relation(fields: [notaEntradaId], references: [id])
  recebidaEm    DateTime?
}

model Estoque {
  id          Int      @id @default(autoincrement())
  produtoId   Int
  produto     Produto  @relation(fields: [produtoId], references: [id])
  tamanho     String
  entradas    Int      @default(0)
  saidas      Int      @default(0)
  minimo      Int      @default(0)
  localizacao String?
  lotes       Lote[]
  @@unique([produtoId, tamanho])
}

model Lote {
  id         Int      @id @default(autoincrement())
  estoqueId  Int
  estoque    Estoque  @relation(fields: [estoqueId], references: [id])
  codigoLote String   // L2606-04
  quantidade Int
  data       DateTime @default(now())
  opId       Int?
  op         OP?      @relation(fields: [opId], references: [id])
}

model Expedicao {
  id             Int      @id @default(autoincrement())
  numero         String   @unique // EXP-0019
  pedidoId       Int?
  clienteId      Int
  endereco       String?
  cidadeUf       String?
  cep            String?
  nf             String?
  transportadora String?
  rastreio       String?
  volumes        Int      @default(1)
  pecas          Int
  loteId         Int?
  parcial        Boolean  @default(false) // expedição/faturamento parcial do pedido
  itens          Json?    // snapshot dos itens desta expedição (parcial): [{produtoId,descricao,quantidade,valorUnit,grade?}]
  caixas         Json?    // plano de embalagem: [{numero,conteudo:[{descricao,cor,tamanho,qtd}],pecas,peso?}]
  status         String   @default("Separado")
  // ===== Dupla conferência + despacho =====
  pecasConferidas   Int      @default(0)
  conferenciaStatus String   @default("pendente") // pendente | conferindo | conferida | despachado
  conferidos        Json?    // códigos já contados (idempotência da conferência)
  conferidoPor      String?
  conferidoEm       DateTime?
  despachadoPor     String?
  dataSaida         DateTime? // data de saída/despacho ao cliente
  // Canhoto assinado da NF (foto/arquivo em base64) arquivado após entrega.
  canhotoImg        String?   @db.Text
  canhotoEm         DateTime?
  data           DateTime @default(now())
}

// ===== Financeiro & sistema =====
model ContaReceber {
  id            Int          @id @default(autoincrement())
  empresaId     Int
  filialId      Int?         // CNPJ proprietário (HC Quality / Yerevan / Cherkesian) que emitiu
  filial        Filial?      @relation(fields: [filialId], references: [id])
  pedidoId      Int?
  notaFiscalId  Int?         // NF que originou o título (cancelamento em cascata)
  clienteId     Int
  documento     String?      // nº do documento/NF de origem (importação)
  vencimento    DateTime
  valor         Decimal      @db.Decimal(12,2)
  pago          Decimal      @default(0) @db.Decimal(12,2)
  juros         Decimal      @default(0) @db.Decimal(12,2) // juros/multa recebidos (atraso)
  status        TituloStatus @default(a_vencer)
}

model ContaPagar {
  id           Int          @id @default(autoincrement())
  empresaId    Int
  filialId     Int?         // CNPJ (HC Quality / Cherkesian) responsável pelo pagamento
  filial       Filial?      @relation(fields: [filialId], references: [id])
  fornecedorId Int?
  categoria    String
  referencia   String?
  vencimento   DateTime
  valor        Decimal      @db.Decimal(12,2)
  pago         Decimal      @default(0) @db.Decimal(12,2)
  juros        Decimal      @default(0) @db.Decimal(12,2) // juros/multa pagos (atraso)
  bancoPagto   String?      // banco/conta de onde saiu o pagamento (registrado na baixa)
  recorrenteId Int?         // origem: conta recorrente que gerou este título (dedup por mês)
  boleto       String?      @db.Text // boleto anexado (data URI base64: PDF/imagem)
  boletoNome   String?      // nome original do arquivo do boleto
  status       TituloStatus @default(a_vencer)
}

/// Conta fixa/recorrente (aluguel, luz, água, internet...) que gera um título a pagar todo mês.
model ContaRecorrente {
  id            Int      @id @default(autoincrement())
  empresaId     Int
  filialId      Int?     // CNPJ pagador
  fornecedorId  Int?
  categoria     String   // ex.: Aluguel, Energia, Água, Internet, Salário, Vale-transporte
  descricao     String?  // ex.: "Aluguel galpão Barueri"
  valor         Decimal  @db.Decimal(12,2)   // usado no modo "fixo"
  tipoCalculo   String   @default("fixo")     // fixo | dia_util (VT/VR = valorDia × dias úteis do mês)
  valorDia      Decimal? @db.Decimal(12,2)    // usado no modo "dia_util"
  diaVencimento Int      // dia do mês (1-31); se o mês não tiver, usa o último dia
  ativa         Boolean  @default(true)
  criadoEm      DateTime @default(now())
}

model Comissao {
  id         Int     @id @default(autoincrement())
  empresaId  Int
  pedidoId   Int
  vendedor   String
  valorVenda Decimal @db.Decimal(12,2)
  percentual Decimal @db.Decimal(5,4)
  comissao   Decimal @db.Decimal(12,2)
  statusPgto String  @default("A pagar")
}

model Documento {
  id         Int      @id @default(autoincrement())
  tipo       String   // proposta, pedido, op, os_faccao, ...
  referencia String?  // id/numero do registro de origem
  numero     String
  urlPdf     String?
  geradoPor  String?
  geradoEm   DateTime @default(now())
}

model Medida { // Ficha de medidas — grade de tamanho por colaborador do cliente
  id          Int      @id @default(autoincrement())
  empresaId   Int
  clienteId   Int
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  colaborador String
  cargo       String?
  tamanho     String   // PP, P, M, G, G2...
  torax       Decimal? @db.Decimal(6,2)
  cintura     Decimal? @db.Decimal(6,2)
  quadril     Decimal? @db.Decimal(6,2)
  altura      Decimal? @db.Decimal(6,2)
  obs         String?
  criadoEm    DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

enum NFeStatus {
  pendente
  autorizada
  rejeitada
  cancelada
  simulada
}

model NotaFiscal {
  id          Int       @id @default(autoincrement())
  empresaId   Int
  filialId    Int?
  filial      Filial?   @relation(fields: [filialId], references: [id])
  expedicaoId Int?
  pedidoId    Int?
  numero      String    @unique // NF-000001
  serie       String    @default("1")
  chave       String?   // chave de acesso (44 dígitos)
  status      NFeStatus @default(pendente)
  protocolo   String?
  motivo      String?   // retorno da SEFAZ/provedor (autorização ou rejeição)
  valor       Decimal   @db.Decimal(12,2)
  provedor    String    @default("simulado") // simulado | focusnfe
  tipo        String    @default("venda")    // venda | remessa (remessa p/ industrialização)
  fornecedorId Int?      // facção destinatária (nas NFs de remessa)
  controleFaccao String? // OS/controle de facção vinculado à remessa
  retornoNf   String?    // nº da NF de retorno da industrialização (fecha a remessa)
  retornadaEm DateTime?  // quando a remessa foi baixada pelo retorno
  notaRefId   Int?       // referência a outra NF (remessa entrega futura -> NF de faturamento)
  ordemCompraCliente String? // nº do pedido de compra do cliente (sai nos dados adicionais)
  cfop        String?    // CFOP(s) da nota (p/ contabilidade) — ex.: "5101" ou "5101/6101"
  natureza    String?    // natureza da operação (ex.: "Venda de mercadoria")
  // Totais fiscais lidos do XML autorizado (p/ o relatório da contabilidade)
  valorProdutos Decimal? @db.Decimal(12,2)
  baseIcms      Decimal? @db.Decimal(12,2)
  valorIcms     Decimal? @db.Decimal(12,2)
  valorPis      Decimal? @db.Decimal(12,2)
  valorCofins   Decimal? @db.Decimal(12,2)
  valorIpi      Decimal? @db.Decimal(12,2)
  emitidaEm   DateTime  @default(now())
  emitidaPor  String?
}

model Log {
  id         Int      @id @default(autoincrement())
  usuario    String
  acao       String
  detalhe    String?
  entidade   String?
  entidadeId String?
  ip         String?
  timestamp  DateTime @default(now())
}

// ===== Rastreabilidade / Kits de Corte (PRD) =====
// Lote de tecido recebido do fornecedor — origem da rastreabilidade.
model LoteTecido {
  id              Int      @id @default(autoincrement())
  empresaId       Int
  codigoLote      String   // LT240715-03
  materialId      Int?     // tecido no estoque (opcional)
  codigoTecido    String?
  descricaoTecido String?
  corTecido       String?
  fornecedorId    Int?
  fornecedorNome  String?
  nfCompra        String?  // nº NF de compra do tecido
  dataRecebimento DateTime?
  criadoEm        DateTime @default(now())
  criadoPor       String?
  kits            Kit[]

  @@unique([empresaId, codigoLote])
}

// KIT = conjunto completo de peças de UM tamanho (1 lote, 1 tamanho).
model Kit {
  id            Int       @id @default(autoincrement())
  empresaId     Int
  codigo        String    @unique // KIT-AAAAMMDD-NNNNNN
  pedidoId      Int?
  opId          Int?
  loteTecidoId  Int?
  lote          LoteTecido? @relation(fields: [loteTecidoId], references: [id])
  clienteNome   String?
  modelo        String?
  variante      String?
  cor           String?
  tamanho       String
  jogos         Int       @default(0)
  pecasTotal    Int       @default(0)
  ordemProducao String?
  ordemCorte    String?
  enfesto       String?
  mesaCorte     String?
  operadorCorte String?
  dataCorte     DateTime?
  faccaoId      Int?
  faccaoNome    String?
  caixa         String?
  transportador String?
  remessaNfId   Int?      // NF de remessa vinculada (não duplica movimentação)
  remessaNfNumero String? // nº da NF de remessa p/ industrialização (facção)
  retornoNfNumero String? // nº da NF de retorno da facção (trava a entrada)
  controleFaccao  String? // Nº da OS/controle gerado automático ao enviar p/ facção (OS-...)
  operacaoFaccao  String? // operação terceirizada: Estamparia/Bordado, Costura, Lavanderia…
  loteTecidoNf    String? // nº do lote/NF do tecido (rastreio na etiqueta da facção)
  custoMaoObra    Decimal? @db.Decimal(12,2) // valor da mão de obra POR PEÇA a pagar ao terceiro (interno = null)
  status        String    @default("aguardando_expedicao") // criado|em_corte|aguardando_expedicao|em_faccao|retornado|em_conferencia|finalizado
  expedidoEm    DateTime?
  expedidoPor   String?
  retornadoEm   DateTime?
  retornadoPor  String?
  qtdRetornada  Int?
  obs           String?
  criadoEm      DateTime  @default(now())
  criadoPor     String?
  eventos       KitEvento[]
}

// Histórico/auditoria de cada evento do KIT.
model KitEvento {
  id        Int      @id @default(autoincrement())
  empresaId Int
  kitId     Int
  kit       Kit      @relation(fields: [kitId], references: [id])
  evento    String   // criado|expedido|retornado|conferido|finalizado|lote_alterado
  detalhe   String?
  usuario   String?
  ip        String?
  criadoEm  DateTime @default(now())
}

// ===== Estoque unitário (etiqueta única por peça + endereçamento) =====
model UnidadeEstoque {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  codigo      String   @unique // UN-AAAAMMDD-NNNNNN (etiqueta da peça)
  tipo        String   // materia | aviamento | produto
  produtoId   Int?
  materialId  Int?
  descricao   String
  cor         String?
  tamanho     String?
  origem      String   @default("entrada") // entrada | producao
  // Endereçamento no armazém
  coluna      String?  // A | B
  andar       String?  // produto acabado: 0..4 · matéria-prima: A/B/C
  caixaMaster String?  // 1.000 .. 10.000
  status      String   @default("aguardando_endereco") // aguardando_endereco(recebimento) | em_estoque | reservado | despachado | quarentena
  areaMotivo  String?  // motivo da quarentena (anomalia, estorno de cliente...)
  pedidoId    Int?
  expedicaoId Int?
  loteEntrada String?  // agrupador da entrada (mesma remessa)
  loteFornecedor String? // lote/partida do tecido informado pelo fornecedor (rastreio produto/lote)
  criadoEm    DateTime @default(now())
  criadoPor   String?
  saidaEm     DateTime?

  @@index([empresaId, status])
  @@index([codigo])
}

// ===== Integração Mercado Livre (OAuth2 + tokens por empresa) =====
/// Loja Tray conectada (a empresa pode ter várias — ex.: Consigaz e Copa Energia).
model TrayConta {
  id            Int       @id @default(autoincrement())
  empresaId     Int
  apelido       String    // nome amigável da loja (ex.: "Consigaz", "Copa Energia")
  consumerKey   String?   // do app na Tray (developers)
  consumerSecret String?
  apiUrl        String?   // web_api da loja, ex.: https://loja.commercesuite.com.br/web_api
  code          String?   // code de autorização (instalação do app na loja)
  accessToken   String?
  refreshToken  String?
  tokenExpira   DateTime?
  storeId       String?   // id da loja na Tray
  conectadoEm   DateTime?
  ativa         Boolean   @default(true)
  atualizadoEm  DateTime  @updatedAt
}

model MercadoLivreConta {
  id            Int       @id @default(autoincrement())
  empresaId     Int       @unique
  appId         String?   // Client ID do app no developers do ML
  appSecret     String?   // Client Secret (guardado no banco privado)
  redirectUri   String?   // URI de callback registrada no app
  accessToken   String?
  refreshToken  String?
  tokenExpira   DateTime? // validade do access token
  mlUserId      String?   // user_id da conta ML conectada
  nickname      String?   // apelido da conta no ML
  conectadoEm   DateTime?
  atualizadoEm  DateTime  @updatedAt
}

/// Configuração do robô comercial de WhatsApp (por empresa).
model WhatsAppConfig {
  id           Int      @id @default(autoincrement())
  empresaId    Int      @unique
  provedor     String   @default("simulado") // simulado | meta | zapi
  token        String?  // access token (Meta Cloud API) ou token (Z-API)
  phoneId      String?  // phone_number_id (Meta) ou instância (Z-API)
  verifyToken  String?  // token de verificação do webhook (Meta)
  saudacao     String?  // mensagem de boas-vindas
  ativo        Boolean  @default(false)
  soContrato   Boolean  @default(true) // atende apenas clientes com contrato
  atualizadoEm DateTime @updatedAt
}

/// Uma conversa de WhatsApp (1 por telefone) com estado (bot/humano/fechado).
model WhatsAppConversa {
  id           Int      @id @default(autoincrement())
  empresaId    Int
  telefone     String
  nome         String?
  clienteId    Int?
  estado       String   @default("bot") // bot | humano | fechado
  pedidoNumero String?  // pedido gerado a partir da conversa
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
  mensagens    WhatsAppMensagem[]

  @@unique([empresaId, telefone])
}

/// Uma mensagem trocada na conversa (histórico + memória do robô).
model WhatsAppMensagem {
  id         Int              @id @default(autoincrement())
  conversaId Int
  conversa   WhatsAppConversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  origem     String           // cliente | bot | humano | sistema
  texto      String
  criadoEm   DateTime         @default(now())
}

/// Embalagem reutilizável (Caixa ou Fardo) — peso vazio + dimensões p/ o cálculo
/// automático de peso bruto e volumes no pedido/NF.
model Embalagem {
  id          Int      @id @default(autoincrement())
  empresaId   Int
  tipo        String   // caixa | fardo
  nome        String
  pesoVazio   Decimal  @default(0) @db.Decimal(10,3) // kg
  comprimento Int?     // cm
  largura     Int?     // cm
  altura      Int?     // cm
  capacidade  Int?     // capacidade padrão (peças) — informativo
  ativo       Boolean  @default(true)
  criadoEm    DateTime @default(now())
}
