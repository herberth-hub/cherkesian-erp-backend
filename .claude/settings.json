{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node comercial-inteligente/bin/hc.js *)"
    ],
    "ask": [
      "Bash(node comercial-inteligente/bin/hc.js *--agente humano*)",
      "Bash(node comercial-inteligente/bin/hc.js *--agente=humano*)",
      "Bash(node comercial-inteligente/bin/hc.js erp *)",
      "Bash(node comercial-inteligente/bin/hc.js demo *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/comercial-inteligente/bin/guard-bash.js\" --auto"
          }
        ]
      }
    ]
  }
}
