{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hc-quality/comercial/lead.schema.json",
  "title": "lead",
  "x-prefixo": "LEA",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^LEA-\\d{4,}$"
    },
    "ficticio": {
      "type": "boolean"
    },
    "origem": {
      "enum": [
        "manual",
        "erp",
        "demo",
        "agente"
      ]
    },
    "erpId": {
      "type": [
        "string",
        "null"
      ]
    },
    "criadoEm": {
      "type": "string",
      "format": "date-time"
    },
    "atualizadoEm": {
      "type": "string",
      "format": "date-time"
    },
    "criadoPor": {
      "enum": [
        "ceo",
        "diretor",
        "gerente",
        "vendedor",
        "hunter",
        "humano"
      ]
    },
    "empresa": {
      "type": "string",
      "minLength": 1
    },
    "cnpj": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{14}$"
    },
    "segmento": {
      "enum": [
        "saude",
        "lavanderia",
        "industria",
        "facilities",
        "construcao",
        "servicos",
        "distribuidores",
        "publico",
        "outro"
      ]
    },
    "fonte": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "novo",
        "qualificado",
        "descartado",
        "convertido"
      ]
    },
    "responsavelId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^AGT-\\d{4,}$"
    },
    "cidadeUf": {
      "type": [
        "string",
        "null"
      ]
    },
    "motivoDescarte": {
      "type": [
        "string",
        "null"
      ]
    },
    "oportunidadeId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^OPO-\\d{4,}$"
    }
  },
  "required": [
    "id",
    "ficticio",
    "criadoEm",
    "empresa",
    "segmento",
    "fonte",
    "status"
  ]
}
