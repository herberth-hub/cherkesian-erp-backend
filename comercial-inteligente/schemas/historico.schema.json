{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hc-quality/comercial/historico.schema.json",
  "title": "historico",
  "x-prefixo": "HIS",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^HIS-\\d{4,}$"
    },
    "ficticio": {
      "type": "boolean"
    },
    "origem": {
      "enum": [
        "manual",
        "erp",
        "demo",
        "agente"
      ]
    },
    "erpId": {
      "type": [
        "string",
        "null"
      ]
    },
    "criadoEm": {
      "type": "string",
      "format": "date-time"
    },
    "atualizadoEm": {
      "type": "string",
      "format": "date-time"
    },
    "criadoPor": {
      "enum": [
        "ceo",
        "diretor",
        "gerente",
        "vendedor",
        "humano"
      ]
    },
    "entidade": {
      "type": "string",
      "minLength": 1
    },
    "registroId": {
      "type": "string",
      "minLength": 1
    },
    "acao": {
      "enum": [
        "criar",
        "atualizar",
        "importar",
        "decidir"
      ]
    },
    "agente": {
      "enum": [
        "ceo",
        "diretor",
        "gerente",
        "vendedor",
        "humano",
        "sistema"
      ]
    },
    "antes": {
      "type": [
        "object",
        "null"
      ]
    },
    "depois": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "required": [
    "id",
    "ficticio",
    "criadoEm",
    "entidade",
    "registroId",
    "acao",
    "agente"
  ]
}
